generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // "CLIENT", "ADMIN", "LOGISTICS"
  name        String
  description String?
  users       User[]
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  roleCode  String    @default("CLIENT")
  role      Role?     @relation(fields: [roleCode], references: [code])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  orders    Order[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street       String
  number       String
  neighborhood String
  city         String   @default("João Pessoa")
  state        String   @default("PB")
  zipCode      String?
  reference    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  icon     String?
  products Product[]
}

model Product {
  id          String         @id @default(uuid())
  name        String
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  priceDaily  Float
  priceWeekly Float?
  image       String
  galleryJSON String?        // JSON Array de URLs adicionais
  description String
  specsJSON   String?        // JSON de especificações (material, capacidade, dimensão)
  stock       Int            @default(50)
  status      String         @default("ACTIVE") // "ACTIVE", "INACTIVE", "MAINTENANCE"
  highlight   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  addons      ProductAddon[]
  orderItems  OrderItem[]
}

model ProductAddon {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Float
}

model Order {
  id            String               @id @default(uuid())
  orderNumber   String               @unique // ex: ORD-2026-8921
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  clientName    String
  whatsapp      String
  startDate     String
  endDate       String
  rentalDays    Int
  neighborhood  String
  address       String
  reference     String?
  notes         String?
  status        String               @default("PENDING") // PENDING, APPROVED, PREPARING, OUT_FOR_DELIVERY, DELIVERED, RETURNED, COMPLETED, CANCELLED
  subtotal      Float
  freightFee    Float
  totalPrice    Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  addOns    String? // JSON string das opções selecionadas
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  comment   String?
  createdAt DateTime @default(now())
}
