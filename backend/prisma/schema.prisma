generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // "DEVELOPER", "STORE_OWNER", "OPERATOR", "CLIENT"
  name        String
  description String?
  users       User[]
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  roleCode  String    @default("CLIENT") // DEVELOPER, STORE_OWNER, OPERATOR, CLIENT
  role      Role?     @relation(fields: [roleCode], references: [code])
  googleId  String?   @unique
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  orders    Order[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street       String
  number       String
  neighborhood String
  city         String   @default("João Pessoa")
  state        String   @default("PB")
  zipCode      String?
  reference    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Department {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  icon       String?
  categories Category[]
  products   Product[]
}

model Category {
  id           String      @id @default(uuid())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  name         String
  slug         String      @unique
  icon         String?
  groups       Group[]
  products     Product[]
}

model Group {
  id         String    @id @default(uuid())
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  name       String
  slug       String    @unique
  products   Product[]
}

model Product {
  id           String           @id @default(uuid())
  sku          String?          @unique // ex: CAD-TIF-BR-01
  name         String
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id])
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id])
  priceDaily   Float
  priceWeekly  Float?
  image        String
  galleryJSON  String?          // JSON Array de URLs adicionais
  description  String
  color        String?          // ex: "Branca", "Preta", "Madeira", "Dourada"
  material     String?          // ex: "Polipropileno", "MDF", "Aço Carbono"
  dimensions   String?          // ex: "1,20m x 75cm"
  maxWeight    String?          // ex: "Até 182 kg"
  specsJSON    String?          // JSON de especificações técnicas completas
  stock        Int              @default(50)
  status       String           @default("ACTIVE") // "ACTIVE", "INACTIVE", "MAINTENANCE"
  highlight    String?
  isKit        Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  addons       ProductAddon[]
  orderItems   OrderItem[]
  maintenances MaintenanceLog[]
}

model ProductAddon {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Float
}

model Order {
  id            String                 @id @default(uuid())
  orderNumber   String                 @unique // ex: ORD-2026-8921
  userId        String?
  user          User?                  @relation(fields: [userId], references: [id])
  clientName    String
  whatsapp      String
  startDate     String
  endDate       String
  rentalDays    Int
  neighborhood  String
  address       String
  reference     String?
  notes         String?
  status        String                 @default("PENDING") // PENDING, APPROVED, PREPARING, OUT_FOR_DELIVERY, DELIVERED, RETURNED, COMPLETED, CANCELLED
  subtotal      Float
  freightFee    Float
  totalPrice    Float
  damagedNotes  String?                // Apontamento de avarias na devolução
  damagedFee    Float                  @default(0) // Taxa cobrada por peças quebradas/faltantes
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  financials    FinancialTransaction[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  addOns    String? // JSON string das opções selecionadas
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  comment   String?
  createdAt DateTime @default(now())
}

model FinancialTransaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // "INCOME" (Entrada/Locação), "EXPENSE" (Saída/Despesa)
  category    String   // "LOCACAO", "MANUTENCAO", "COMPRA_ACERVO", "FRETE", "CONTAS_FIXAS"
  dueDate     String?
  paidDate    String?
  status      String   @default("PAID") // "PENDING", "PAID", "OVERDUE"
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  createdAt   DateTime @default(now())
}

model MaintenanceLog {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int      @default(1)
  issueDescription String
  cost             Float    @default(0)
  status           String   @default("IN_REPAIR") // "IN_REPAIR", "RESOLVED", "DISCARDED"
  createdAt        DateTime @default(now())
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  category      String?  // "MOVEIS", "LONAS_TENDAS", "ENXOVAL", "FESTAS"
  createdAt     DateTime @default(now())
}

model CompanySetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
